{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // 브라우저 번들(esbuild iife)이라 package.json "type"과 무관하게 ESM으로 봐요.
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
