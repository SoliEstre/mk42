{
  "name": "@mark42/daemon",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "mk42d": "./dist/mk42d.mjs"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/mk42d.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && node scripts/write-legacy-shim.mjs && npm run build:setup",
    "build:setup": "esbuild src/setup/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/mk42-setup.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node src/main.ts",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mark42/protocol": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.12"
  }
}
