@@ -0,0 +1,21 @@
+/*---------------------------------------------------------------------------------------------
+ *  Mark42 (Mk42) — lightweight build of Code - OSS for AI coding agents.
+ *  `mark42.extensions.restartUpdated`: restart the extension host onto extension versions that were
+ *  installed from outside this window (the Mark42 daemon updates Claude Code / Codex with the CLI).
+ *  `workbench.action.restartExtensionHost` keeps the old versions (it does not pass the update delta);
+ *  this goes the way of the Extensions view's «Restart Extensions». Returns how many extensions are
+ *  restarted onto a new version (0: nothing to do — the caller may reload the window instead).
+ *--------------------------------------------------------------------------------------------*/
+
+import { CommandsRegistry } from '../../../../platform/commands/common/commands.js';
+import { ExtensionRuntimeActionType, IExtensionsWorkbenchService } from '../../extensions/common/extensions.js';
+
+CommandsRegistry.registerCommand('mark42.extensions.restartUpdated', async (accessor): Promise<number> => {
+	const extensions = accessor.get(IExtensionsWorkbenchService);
+	await extensions.queryLocal();
+	const pending = extensions.local.filter(e => e.runtimeState?.action === ExtensionRuntimeActionType.RestartExtensions).length;
+	if (pending > 0) {
+		await extensions.updateRunningExtensions('Mark42: restarting extensions onto their updated versions');
+	}
+	return pending;
+});
