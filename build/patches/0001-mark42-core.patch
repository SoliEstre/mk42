+/*---------------------------------------------------------------------------------------------
+ *  Mark42 (Mk42) — lightweight build of Code - OSS for AI coding agents.
+ *  Helpers for the Mark42 extension's views that the extension API cannot do for a view it
+ *  contributes into another extension's container (the Claude Code / Codex side bar):
+ *  - the «작업» (background tasks) view goes above the agent view once per profile (a later
+ *    rearrangement by the user is kept). The agent extension is installed after the first window
+ *    opens, so until then the view sits in Explorer (fallback of an unknown container): it is moved
+ *    into the agent container as soon as that appears, and «done» is stored only once it is first
+ *    there next to an agent view;
+ *  - `mark42.views.resetAgentLayout`: «작업·에이전트 영역 기본 배치로 되돌리기» — tasks view and
+ *    the agent views back into the agent container, the container back to the secondary side bar,
+ *    tasks first, both shown and expanded, side bar maximized;
+ *  - `mark42.views.fitHeight(viewId, contentPx)`: size the view to its content, at most half of
+ *    the container;
+ *  - `mark42.views.setTitleLabel(viewId, text, tooltip, command)`: a text item at the left of the
+ *    view's title actions (the agent extension's version next to the Mark42 buttons).
+ *  Only views and commands with the `mark42.` prefix are touched.
+ *--------------------------------------------------------------------------------------------*/
+
+import { timeout } from '../../../../base/common/async.js';
+import { Disposable, DisposableMap, DisposableStore, IDisposable } from '../../../../base/common/lifecycle.js';
+import { language } from '../../../../base/common/platform.js';
+import { DEFAULT_PANE_HEADER_SIZE } from '../../../../base/browser/ui/splitview/paneview.js';
+import { Action2, MenuId, MenuRegistry, registerAction2 } from '../../../../platform/actions/common/actions.js';
+import { CommandsRegistry, ICommandService } from '../../../../platform/commands/common/commands.js';
+import { ContextKeyExpr, IContextKeyService } from '../../../../platform/contextkey/common/contextkey.js';
+import { ServicesAccessor } from '../../../../platform/instantiation/common/instantiation.js';
+import { Registry } from '../../../../platform/registry/common/platform.js';
+import { IStorageService, StorageScope, StorageTarget } from '../../../../platform/storage/common/storage.js';
+import { ViewPane } from '../../../browser/parts/views/viewPane.js';
+import { ViewPaneContainer } from '../../../browser/parts/views/viewPaneContainer.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { Extensions as ViewExtensions, IViewDescriptorService, IViewsRegistry, ViewContainer, ViewContainerLocation, ViewVisibilityState } from '../../../common/views.js';
+import { IWorkbenchLayoutService, Parts } from '../../../services/layout/browser/layoutService.js';
+import { IViewsService } from '../../../services/views/common/viewsService.js';
+
+/** Mark42 확장 package.json의 «작업» 보기와 그 보기가 들어갈 에이전트 컨테이너(뷰 컨테이너 id = `workbench.view.extension.<키>`) */
+const AGENT_LAYOUTS: readonly { kind: string; tasksView: string; container: string; agentViews: readonly string[] }[] = [
+	{ kind: 'claude', tasksView: 'mark42.tasks.claude', container: 'workbench.view.extension.claude-sidebar-secondary', agentViews: ['claudeVSCodeSidebarSecondary'] },
+	{ kind: 'codex', tasksView: 'mark42.tasks.codex', container: 'workbench.view.extension.codexSecondaryViewContainer', agentViews: ['chatgpt.sidebarSecondaryView'] },
+];
+
+/** 프로필마다 한 번 «작업» 보기를 맨 위로 — v1 키는 탐색기(대체 컨테이너)에서 세워진 경우가 있어 다시 한 번 해요 */
+const onTopKey = (viewId: string) => `mark42.tasksViewOnTop.v2.${viewId}`;
+const legacyOnTopKey = (viewId: string) => `mark42.tasksViewOnTop.${viewId}`;
+
+const AGENT_WINDOW = ContextKeyExpr.has('mark42.agentWindow');
+const isKorean = language.toLowerCase().startsWith('ko');
+
+/** 마지막으로 받은 «작업» 보기 내용 높이(mark42.views.fitHeight) — 배치 되돌리기 뒤에 다시 맞출 때 써요 */
+const lastContentPx = new Map<string, number>();
+
+/** 내용 높이에 맞는 보기 크기: 최소 크기 이상, 최대 컨테이너의 반 */
+function fitSize(paneContainer: ViewPaneContainer, pane: ViewPane, contentPx: number): number {
+	const total = paneContainer.panes.reduce((sum, p) => sum + paneContainer.getPaneSize(p), 0);
+	return Math.round(Math.min(total / 2, Math.max(pane.minimumBodySize + DEFAULT_PANE_HEADER_SIZE, contentPx + DEFAULT_PANE_HEADER_SIZE)));
+}
+
+/**
+ * 보기를 컨테이너 모델 맨 앞으로. `IViewContainerModel.move`는 이미 그려진 창(pane)을 옮기지 않아서, 창이 있으면
+ * `ViewPaneContainer.movePane`으로 옮겨요. 창은 있는데 그 컨테이너가 지금 열려 있지 않으면 false(나중에 다시).
+ */
+function moveViewFirst(viewDescriptorService: IViewDescriptorService, viewsService: IViewsService, container: ViewContainer, viewId: string): boolean {
+	const model = viewDescriptorService.getViewContainerModel(container);
+	if (!model.allViewDescriptors.some(v => v.id === viewId)) {
+		return false;
+	}
+	if (model.allViewDescriptors[0].id === viewId) {
+		return true;
+	}
+	if (viewsService.getViewWithId(viewId)) {
+		const paneContainer = viewsService.getActiveViewPaneContainerWithId(container.id);
+		if (!(paneContainer instanceof ViewPaneContainer)) {
+			return false;
+		}
+		const pane = paneContainer.getView(viewId);
+		const firstPane = paneContainer.panes[0];
+		if (pane && firstPane && pane !== firstPane) {
+			paneContainer.movePane(pane, firstPane);
+		}
+	}
+	// 보이는 창들 사이 순서는 그대로 두고(앞에 남은 것은 안 보이는 보기뿐), 모델에서도 맨 앞으로
+	const first = model.allViewDescriptors[0];
+	if (first.id !== viewId) {
+		model.move(viewId, first.id);
+	}
+	return model.allViewDescriptors[0]?.id === viewId;
+}
+
+class Mark42ViewsContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.mark42Views';
+
+	private placing = false;
+
+	constructor(
+		@IViewDescriptorService private readonly viewDescriptorService: IViewDescriptorService,
+		@IStorageService private readonly storageService: IStorageService,
+		@IViewsService private readonly viewsService: IViewsService,
+	) {
+		super();
+		this.placeTasksViews();
+		const again = () => this.placeTasksViews();
+		this._register(Registry.as<IViewsRegistry>(ViewExtensions.ViewsRegistry).onViewsRegistered(again));
+		this._register(this.viewDescriptorService.onDidChangeViewContainers(again));
+		this._register(this.viewDescriptorService.onDidChangeContainer(again));
+		this._register(this.viewsService.onDidChangeViewContainerVisibility(again));
+	}
+
+	/**
+	 * 프로필마다 한 번, 보기마다: 에이전트 컨테이너 맨 위에. 그 뒤로는 사용자가 놓은 자리를 그대로 둬요.
+	 * «끝»은 보기가 에이전트 컨테이너에서 에이전트 보기와 함께 있고 맨 앞이 된 뒤에만 저장해요.
+	 */
+	private placeTasksViews(): void {
+		if (this.placing) {
+			return; // 아래 이동이 다시 부른 이벤트
+		}
+		this.placing = true;
+		try {
+			for (const layout of AGENT_LAYOUTS) {
+				this.placeTasksView(layout);
+			}
+		} finally {
+			this.placing = false;
+		}
+	}
+
+	private placeTasksView(layout: typeof AGENT_LAYOUTS[number]): void {
+		const id = layout.tasksView;
+		const key = onTopKey(id);
+		if (this.storageService.getBoolean(key, StorageScope.PROFILE, false)) {
+			return;
+		}
+		const descriptor = this.viewDescriptorService.getViewDescriptorById(id);
+		const expected = this.viewDescriptorService.getViewContainerById(layout.container);
+		if (!descriptor || !expected) {
+			return; // Mark42 확장이나 에이전트 확장이 (아직) 없어요 — 편집 창에서는 에이전트 확장이 꺼져 있어요
+		}
+		const current = this.viewDescriptorService.getViewContainerByViewId(id);
+		if (!current) {
+			return; // 옮겨 둔 컨테이너가 아직 등록 전이에요
+		}
+		if (current !== expected) {
+			const defaultContainer = this.viewDescriptorService.getDefaultContainerById(id);
+			if (defaultContainer === expected || current !== defaultContainer) {
+				// 사용자가 다른 곳으로 옮긴 보기 — 그 자리를 존중하고 다시 손대지 않아요
+				this.markDone(id);
+				return;
+			}
+			// 에이전트 확장보다 먼저 등록돼 탐색기(알 수 없는 컨테이너의 대체)에 들어간 보기 — 이제 에이전트 컨테이너가 있으니 옮겨요
+			this.viewDescriptorService.moveViewsToContainer([descriptor], expected, ViewVisibilityState.Default, 'mark42: agent container registered after the tasks view');
+			if (this.viewDescriptorService.getViewContainerByViewId(id) !== expected) {
+				return;
+			}
+		}
+		const model = this.viewDescriptorService.getViewContainerModel(expected);
+		if (!model.allViewDescriptors.some(v => !v.id.startsWith('mark42.'))) {
+			return; // 에이전트 보기가 아직 등록되지 않았어요 — 지금 맨 앞이어도 나중에 들어올 보기가 순서를 정해요
+		}
+		if (moveViewFirst(this.viewDescriptorService, this.viewsService, expected, id)) {
+			this.markDone(id);
+		}
+	}
+
+	private markDone(viewId: string): void {
+		this.storageService.store(onTopKey(viewId), true, StorageScope.PROFILE, StorageTarget.MACHINE);
+		this.storageService.remove(legacyOnTopKey(viewId), StorageScope.PROFILE);
+	}
+}
+
+registerWorkbenchContribution2(Mark42ViewsContribution.ID, Mark42ViewsContribution, WorkbenchPhase.AfterRestored);
+
+CommandsRegistry.registerCommand('mark42.views.fitHeight', (accessor, viewId: unknown, contentPx: unknown): boolean => {
+	if (typeof viewId !== 'string' || !viewId.startsWith('mark42.') || typeof contentPx !== 'number' || !Number.isFinite(contentPx) || contentPx < 0) {
+		return false;
+	}
+	lastContentPx.set(viewId, contentPx);
+	const container = accessor.get(IViewDescriptorService).getViewContainerByViewId(viewId);
+	const paneContainer = container ? accessor.get(IViewsService).getActiveViewPaneContainerWithId(container.id) : null;
+	if (!(paneContainer instanceof ViewPaneContainer)) {
+		return false;
+	}
+	const pane = paneContainer.getView(viewId);
+	if (!(pane instanceof ViewPane) || !pane.isExpanded() || paneContainer.panes.length < 2) {
+		return false;
+	}
+	const want = fitSize(paneContainer, pane, contentPx);
+	if (Math.abs(paneContainer.getPaneSize(pane) - want) >= 2) {
+		paneContainer.resizePane(pane, want);
+	}
+	return true;
+});
+
+const RESET_AGENT_LAYOUT_ID = 'mark42.views.resetAgentLayout';
+const RESET_AGENT_LAYOUT_TITLE = { value: isKorean ? '작업·에이전트 영역 기본 배치로 되돌리기' : 'Reset Tasks and Agent Layout', original: 'Reset Tasks and Agent Layout' };
+
+/**
+ * 작업·에이전트 영역 기본 배치로 되돌리기: 에이전트 컨테이너(이 창의 에이전트 종류)만 다뤄요 — «작업» 보기와 에이전트 확장의
+ * 보기를 원래 컨테이너로(다른 컨테이너·패널·끌어다 놓아 생긴 새 컨테이너에서), 컨테이너를 기본 위치(보조 사이드바)로, «작업»을
+ * 맨 위에, 둘 다 보이고 펼친 상태로, «작업» 높이는 내용에 맞게(모르면 컨테이너의 1/4), 보조 사이드바를 열고 최대화.
+ */
+registerAction2(class ResetAgentLayoutAction extends Action2 {
+	constructor() {
+		super({
+			id: RESET_AGENT_LAYOUT_ID,
+			title: RESET_AGENT_LAYOUT_TITLE,
+			category: { value: 'Mark42', original: 'Mark42' },
+			f1: true,
+			precondition: AGENT_WINDOW,
+			menu: [{
+				id: MenuId.MenubarAppearanceMenu,
+				group: '3_workbench_layout_move',
+				order: 100,
+				when: AGENT_WINDOW,
+			}, {
+				id: MenuId.ViewTitle,
+				group: 'z_mark42',
+				order: 1,
+				when: ContextKeyExpr.and(ContextKeyExpr.regex('view', /^mark42\.tasks\./), AGENT_WINDOW),
+			}],
+		});
+	}
+
+	async run(accessor: ServicesAccessor): Promise<void> {
+		const viewDescriptorService = accessor.get(IViewDescriptorService);
+		const viewsService = accessor.get(IViewsService);
+		const layoutService = accessor.get(IWorkbenchLayoutService);
+		const storageService = accessor.get(IStorageService);
+		const kind = accessor.get(IContextKeyService).getContextKeyValue<string>('mark42.agentKind');
+		const viewsRegistry = Registry.as<IViewsRegistry>(ViewExtensions.ViewsRegistry);
+
+		const layouts = AGENT_LAYOUTS.filter(l => viewDescriptorService.getViewContainerById(l.container) && (!kind || l.kind === kind));
+		for (const layout of layouts) {
+			const container = viewDescriptorService.getViewContainerById(layout.container);
+			if (!container) {
+				continue;
+			}
+			const defaultLocation = viewDescriptorService.getDefaultViewContainerLocation(container);
+			if (defaultLocation !== null && viewDescriptorService.getViewContainerLocation(container) !== defaultLocation) {
+				viewDescriptorService.moveViewContainerToLocation(container, defaultLocation, undefined, RESET_AGENT_LAYOUT_ID);
+			}
+			// 이 컨테이너가 기본 자리인 보기(에이전트 확장 것) + «작업» 보기(에이전트 확장보다 먼저 등록되면 기본 자리가 탐색기라 따로)
+			const ids = new Set([...viewsRegistry.getViews(container).map(v => v.id), layout.tasksView]);
+			for (const id of ids) {
+				const descriptor = viewDescriptorService.getViewDescriptorById(id);
+				const current = viewDescriptorService.getViewContainerByViewId(id);
+				if (descriptor && current && current !== container) {
+					viewDescriptorService.moveViewsToContainer([descriptor], container, ViewVisibilityState.Expand, RESET_AGENT_LAYOUT_ID);
+				}
+			}
+		}
+		const layout = layouts[0];
+		const container = layout && viewDescriptorService.getViewContainerById(layout.container);
+		if (!layout || !container) {
+			return;
+		}
+
+		// 보일 보기: «작업» + 에이전트 보기(알려진 id, 그 밖에 기본으로 보이는 에이전트 확장 보기)
+		const model = viewDescriptorService.getViewContainerModel(container);
+		const inModel = (id: string) => model.allViewDescriptors.some(v => v.id === id);
+		const shown = [layout.tasksView, ...model.allViewDescriptors
+			.filter(v => !v.id.startsWith('mark42.') && viewsRegistry.getViewContainer(v.id) === container && (layout.agentViews.includes(v.id) || !v.hideByDefault))
+			.map(v => v.id)].filter(inModel);
+		for (const id of shown) {
+			model.setCollapsed(id, false);
+			model.setVisible(id, true);
+		}
+
+		await viewsService.openViewContainer(container.id, false);
+		if (viewDescriptorService.getViewContainerLocation(container) === ViewContainerLocation.AuxiliaryBar) {
+			layoutService.setPartHidden(false, Parts.AUXILIARYBAR_PART);
+			layoutService.setAuxiliaryBarMaximized(true);
+		}
+
+		const paneContainer = viewsService.getActiveViewPaneContainerWithId(container.id);
+		if (paneContainer instanceof ViewPaneContainer) {
+			for (const id of shown) {
+				paneContainer.getView(id)?.setExpanded(true);
+			}
+		}
+		if (moveViewFirst(viewDescriptorService, viewsService, container, layout.tasksView)) {
+			storageService.store(onTopKey(layout.tasksView), true, StorageScope.PROFILE, StorageTarget.MACHINE);
+		}
+
+		// 최대화·창 추가 뒤 레이아웃이 자리 잡으면 «작업» 높이: 마지막 내용 높이에 맞게, 모르면 컨테이너의 1/4(최소 크기 이상)
+		await timeout(50);
+		const panes = viewsService.getActiveViewPaneContainerWithId(container.id);
+		const tasksPane = panes instanceof ViewPaneContainer ? panes.getView(layout.tasksView) : undefined;
+		if (panes instanceof ViewPaneContainer && tasksPane instanceof ViewPane && tasksPane.isExpanded() && panes.panes.length >= 2) {
+			const contentPx = lastContentPx.get(layout.tasksView);
+			const total = panes.panes.reduce((sum, p) => sum + panes.getPaneSize(p), 0);
+			const want = contentPx !== undefined
+				? fitSize(panes, tasksPane, contentPx)
+				: Math.round(Math.max(tasksPane.minimumBodySize + DEFAULT_PANE_HEADER_SIZE, total / 4));
+			panes.resizePane(tasksPane, want);
+		}
+	}
+});
+
+const titleLabels = new DisposableMap<string, IDisposable>();
+
+CommandsRegistry.registerCommand('mark42.views.setTitleLabel', (_accessor, viewId: unknown, text: unknown, tooltip: unknown, command: unknown): boolean => {
+	if (typeof viewId !== 'string' || viewId.length > 128) {
+		return false;
+	}
+	titleLabels.deleteAndDispose(viewId);
+	if (typeof text !== 'string' || !text) {
+		return true; // cleared
+	}
+	const store = new DisposableStore();
+	const id = `mark42.views.titleLabel.${viewId}`;
+	const run = typeof command === 'string' && command.startsWith('mark42.') ? command : undefined;
+	store.add(CommandsRegistry.registerCommand(id, accessor => run ? accessor.get(ICommandService).executeCommand(run) : undefined));
+	store.add(MenuRegistry.appendMenuItem(MenuId.ViewTitle, {
+		command: { id, title: text.slice(0, 40), tooltip: typeof tooltip === 'string' ? tooltip.slice(0, 200) : undefined },
+		when: ContextKeyExpr.equals('view', viewId),
+		group: 'navigation',
+		order: 80,
+	}));
+	titleLabels.set(viewId, store);
+	return true;
+});
diff --git a/src/vs/workbench/contrib/mark42/electron-browser/mark42AgentIcon.contribution.ts b/src/vs/workbench/contrib/mark42/electron-browser/mark42AgentIcon.contribution.ts
new file mode 100644
index 00000000..0bef530d
--- /dev/null
+++ b/src/vs/workbench/contrib/mark42/electron-browser/mark42AgentIcon.contribution.ts
@@ -0,0 +1,114 @@
+/*---------------------------------------------------------------------------------------------
+ *  Mark42 (Mk42) — lightweight build of Code - OSS for AI coding agents.
+ *  Agent windows (workspace setting `mark42.role`, written by the Mark42 daemon) get the agent's
+ *  extension icon as a small badge on the top-left of the Mk42 icon: in the window icon
+ *  (Alt+Tab, thumbnails, taskbar buttons when they are not combined — a combined or pinned
+ *  button shows the app icon) and in the title bar. The agent logo is read from the installed
+ *  extension at runtime and never shipped with Mark42. Other windows keep the plain Mk42 icon.
+ *--------------------------------------------------------------------------------------------*/
+
+import { mainWindow } from '../../../../base/browser/window.js';
+import { onUnexpectedError } from '../../../../base/common/errors.js';
+import { Disposable } from '../../../../base/common/lifecycle.js';
+import { FileAccess } from '../../../../base/common/network.js';
+import { isMacintosh } from '../../../../base/common/platform.js';
+import { joinPath } from '../../../../base/common/resources.js';
+import { IConfigurationService } from '../../../../platform/configuration/common/configuration.js';
+import { IFileService } from '../../../../platform/files/common/files.js';
+import { ILogService } from '../../../../platform/log/common/log.js';
+import { INativeHostService } from '../../../../platform/native/common/native.js';
+import { IWorkbenchContribution, registerWorkbenchContribution2, WorkbenchPhase } from '../../../common/contributions.js';
+import { IExtensionService } from '../../../services/extensions/common/extensions.js';
+
+/** `mark42.role` → the extension whose icon marks that window */
+const AGENT_EXTENSIONS: Readonly<Record<string, string>> = {
+	'agent-claude': 'anthropic.claude-code',
+	'agent-codex': 'openai.chatgpt',
+};
+
+const WINDOW_ICON_SIZE = 256;
+const TITLEBAR_ICON_SIZE = 64;
+
+function loadImage(src: string): Promise<HTMLImageElement> {
+	return new Promise((resolve, reject) => {
+		const image = new Image();
+		image.onload = () => resolve(image);
+		image.onerror = () => reject(new Error(`image not loaded: ${src.slice(0, 80)}`));
+		image.src = src;
+	});
+}
+
+/** Same layout as the hub's Mk42 + VS Code icon: badge about half the size, on a dark rounded plate so it reads on the red Mk42 plate */
+function compose(base: HTMLImageElement, badge: HTMLImageElement, size: number): string {
+	const canvas = mainWindow.document.createElement('canvas');
+	canvas.width = canvas.height = size;
+	const ctx = canvas.getContext('2d');
+	if (!ctx) {
+		throw new Error('no 2d canvas');
+	}
+	ctx.imageSmoothingQuality = 'high';
+	ctx.drawImage(base, 0, 0, size, size);
+	const s = Math.round(size * 0.45) + Math.floor(size / 16);
+	const radius = Math.max(1.5, s / 6);
+	ctx.fillStyle = 'rgba(24, 20, 14, 0.92)';
+	ctx.beginPath();
+	ctx.roundRect(0, 0, s, s, radius);
+	ctx.fill();
+	const pad = Math.max(1, Math.floor(s / 10));
+	ctx.drawImage(badge, pad, pad, s - 2 * pad, s - 2 * pad);
+	return canvas.toDataURL('image/png');
+}
+
+class Mark42AgentIconContribution extends Disposable implements IWorkbenchContribution {
+
+	static readonly ID = 'workbench.contrib.mark42AgentIcon';
+
+	constructor(
+		@IConfigurationService configurationService: IConfigurationService,
+		@IExtensionService private readonly extensionService: IExtensionService,
+		@IFileService private readonly fileService: IFileService,
+		@INativeHostService private readonly nativeHostService: INativeHostService,
+		@ILogService private readonly logService: ILogService,
+	) {
+		super();
+		if (isMacintosh) {
+			return;
+		}
+		const role = configurationService.getValue<unknown>('mark42.role');
+		const extensionId = typeof role === 'string' && Object.hasOwn(AGENT_EXTENSIONS, role) ? AGENT_EXTENSIONS[role] : undefined;
+		this.apply(extensionId).catch(e => {
+			this.logService.warn(`[mark42] agent icon not applied: ${e instanceof Error ? e.message : String(e)}`);
+			onUnexpectedError(e);
+		});
+	}
+
+	private async apply(extensionId: string | undefined): Promise<void> {
+		if (extensionId) {
+			await this.extensionService.whenInstalledExtensionsRegistered();
+		}
+		const extension = extensionId ? await this.extensionService.getExtension(extensionId) : undefined;
+		if (!extension?.icon) {
+			// No agent role, or its extension is not here: plain Mk42 icon. The BrowserWindow outlives this
+			// workbench (a folder opened into the same window), so a badge from an earlier load is taken off.
+			await this.nativeHostService.mark42SetWindowIcon(undefined);
+			return;
+		}
+		const content = await this.fileService.readFile(joinPath(extension.extensionLocation, extension.icon));
+		const badgeUrl = URL.createObjectURL(new Blob([content.value.buffer as Uint8Array<ArrayBuffer>], { type: 'image/png' }));
+		try {
+			const [base, badge] = await Promise.all([
+				loadImage(FileAccess.asBrowserUri('vs/workbench/browser/media/code-icon.svg').toString(true)),
+				loadImage(badgeUrl),
+			]);
+			await this.nativeHostService.mark42SetWindowIcon(compose(base, badge, WINDOW_ICON_SIZE));
+			const appIcon = mainWindow.document.querySelector<HTMLElement>('.part.titlebar .window-appicon:not(.codicon)');
+			if (appIcon) {
+				appIcon.style.backgroundImage = `url('${compose(base, badge, TITLEBAR_ICON_SIZE)}')`;
+			}
+		} finally {
+			URL.revokeObjectURL(badgeUrl);
+		}
+	}
+}
+
+registerWorkbenchContribution2(Mark42AgentIconContribution.ID, Mark42AgentIconContribution, WorkbenchPhase.Eventually);
