+/*---------------------------------------------------------------------------------------------
+ *  Mark42 (Mk42) — lightweight build of Code - OSS for AI coding agents.
+ *  Default values for settings that core reads early (before extensions register their
+ *  configurationDefaults) or in the main process. Users can still override them in settings.json.
+ *--------------------------------------------------------------------------------------------*/
+
+import { Registry } from '../../platform/registry/common/platform.js';
+import { Extensions, IConfigurationRegistry } from '../../platform/configuration/common/configurationRegistry.js';
+
+export const MARK42_DEFAULTS: Readonly<Record<string, unknown>> = {
+	// Built-in AI (Copilot chat, Agent Host, Agents window) — Claude Code and Codex run as their own extensions
+	'chat.disableAIFeatures': true,
+	'chat.agentHost.claudeAgent.enabled': false,
+	'chat.agentHost.codexAgent.enabled': false,
+	'chat.editor.codex.preferAgentHost': false,
+	'chat.agentMerge.enabled': false,
+	'chat.agentsWindowBanner.enabled': false,
+	'chat.agentsControl.enabled': false,
+	'chat.copilotCliCommand.enabled': false,
+	'chat.inlineChat.agentHost.enabled': false,
+	'chat.terminal.agentHost.enabled': false,
+	'chat.mcp.autostart': 'never',
+	'chat.mcp.gallery.enabled': false,
+	// No telemetry, experiments or update checks (no endpoints in product.json either)
+	'telemetry.telemetryLevel': 'off',
+	'telemetry.feedback.enabled': false,
+	'workbench.enableExperiments': false,
+	'update.mode': 'none',
+	'update.showReleaseNotes': false,
+	// Windows are opened and restored by the Mark42 daemon (mk42d)
+	'window.restoreWindows': 'none',
+	// Agent windows start without an editor: no welcome page, walkthroughs, tips or recommendations
+	'workbench.startupEditor': 'none',
+	'workbench.welcomePage.walkthroughs.openOnInstall': false,
+	'workbench.tips.enabled': false,
+	'extensions.ignoreRecommendations': true,
+	// Code - OSS has no Microsoft signature verifier (see extensionManagementService.ts)
+	'extensions.verifySignature': false,
+};
+
+Registry.as<IConfigurationRegistry>(Extensions.Configuration).registerDefaultConfigurations([{ overrides: { ...MARK42_DEFAULTS }, source: 'Mark42' }]);
